diff --git a/src/modules/simulation/gz_bridge/GZBridge.cpp b/src/modules/simulation/gz_bridge/GZBridge.cpp
index 3ef65e186f..ed17680846 100644
--- a/src/modules/simulation/gz_bridge/GZBridge.cpp
+++ b/src/modules/simulation/gz_bridge/GZBridge.cpp
@@ -156,6 +156,14 @@ int GZBridge::init()
 		return PX4_ERROR;
 	}
 
+	// external wrench for disturbance injection (only consumed if the world loads IjcWrenchSystem)
+	_ijc_wrench_pub = _node.Advertise<gz::msgs::EntityWrench>("/world/" + _world_name + "/ijc_wrench");
+
+	// aerodynamic wrench measured in Gazebo (only published if the world loads IjcAeroSystem)
+	if (!_node.Subscribe("/world/" + _world_name + "/ijc_aero", &GZBridge::ijcAeroCallback, this)) {
+		PX4_WARN("failed to subscribe to ijc_aero");
+	}
+
 	ScheduleNow();
 	return OK;
 }
@@ -344,6 +352,42 @@ void GZBridge::clockCallback(const gz::msgs::Clock &msg)
 		// Keep monotonic clock synchronized
 		px4_clock_settime(CLOCK_MONOTONIC, &ts);
 	}
+
+	forwardIjcWrench();
+}
+
+void GZBridge::ijcAeroCallback(const gz::msgs::Wrench &msg)
+{
+	// ENU force -> NED, FLU torque -> FRD
+	ijc_aero_s aero{};
+	aero.timestamp_sample = msg.header().stamp().sec() * 1000000ULL + msg.header().stamp().nsec() / 1000ULL;
+	aero.force_ned[0] = msg.force().y();
+	aero.force_ned[1] = msg.force().x();
+	aero.force_ned[2] = -msg.force().z();
+	aero.torque_frd[0] = msg.torque().x();
+	aero.torque_frd[1] = -msg.torque().y();
+	aero.torque_frd[2] = -msg.torque().z();
+	aero.timestamp = hrt_absolute_time();
+	_ijc_aero_pub.publish(aero);
+}
+
+void GZBridge::forwardIjcWrench()
+{
+	ijc_wrench_s wrench;
+
+	if (!_ijc_wrench_pub.Valid() || !_ijc_wrench_sub.update(&wrench)) {
+		return;
+	}
+
+	// NED force -> ENU (world), FRD torque -> FLU (body)
+	gz::msgs::EntityWrench msg;
+	msg.mutable_entity()->set_name(_model_name);
+	msg.mutable_entity()->set_type(gz::msgs::Entity::MODEL);
+	gz::msgs::Set(msg.mutable_wrench()->mutable_force(),
+		      gz::math::Vector3d(wrench.force_ned[1], wrench.force_ned[0], -wrench.force_ned[2]));
+	gz::msgs::Set(msg.mutable_wrench()->mutable_torque(),
+		      gz::math::Vector3d(wrench.torque_frd[0], -wrench.torque_frd[1], -wrench.torque_frd[2]));
+	_ijc_wrench_pub.Publish(msg);
 }
 
