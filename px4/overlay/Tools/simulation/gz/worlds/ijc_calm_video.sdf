<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="ijc_calm_video">
    <!-- video version of ijc_calm.sdf (scripts/make_videos.sh): same physics, plus camera/markers -->
    <!-- ijc_control experiments: 1 kHz physics, standard gravity (= PX4 CONSTANTS_ONE_G),
         default PX4 systems plus IjcWrenchSystem (disturbance injection). -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libIjcWrenchSystem.so" name="custom::IjcWrenchSystem">
      <link_name>base_link</link_name>
    </plugin>
    <!-- aerodynamic wrench on the vehicle (ground truth for the observers); runs after the model systems -->
    <plugin filename="libIjcAeroSystem.so" name="custom::IjcAeroSystem">
      <gz:system_priority>100</gz:system_priority>
      <model_name>quadtailsitter_ijc_0</model_name>
      <base_link>base_link</base_link>
      <moment_constant>0.06</moment_constant>
      <rotor direction="ccw">rotor_0</rotor>
      <rotor direction="ccw">rotor_1</rotor>
      <rotor direction="cw">rotor_2</rotor>
      <rotor direction="cw">rotor_3</rotor>
    </plugin>
    <plugin filename="libIjcVideoSystem.so" name="custom::IjcVideoSystem">
      <model_name>quadtailsitter_ijc_0</model_name>
      <link_name>base_link</link_name>
      <camera_model>ijc_cam</camera_model>
      <camera_offset>2.4 -1.0 1.3</camera_offset>
      <reference_model>ijc_ref</reference_model>
      <reference_height>2.5</reference_height>
    </plugin>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <!-- ===== video only: follow camera, reference marker, floor grid (IjcVideoSystem) ===== -->
    <model name="ijc_cam">
      <static>true</static>
      <pose>3.2 -1.2 3.5 0 0 0</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
          <topic>ijc_cam</topic>
          <camera>
            <horizontal_fov>0.75</horizontal_fov>
            <image><width>640</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>200</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
    <model name="ijc_ref">
      <static>true</static>
      <pose>0 0 -10 0 0 0</pose>
      <link name="link">
        <visual name="sphere">
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <transparency>0.45</transparency>
          <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.9 0 1</diffuse><emissive>0 0.35 0 1</emissive></material>
        </visual>
        <visual name="cross_z">
          <geometry><box><size>0.01 0.01 0.5</size></box></geometry>
          <material><ambient>0 0.5 0 1</ambient><diffuse>0 0.6 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="ijc_grid">
      <static>true</static>
      <link name="link">
        <visual name="gx0"><pose>-8 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy0"><pose>0 -8 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx1"><pose>-7 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy1"><pose>0 -7 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx2"><pose>-6 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy2"><pose>0 -6 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx3"><pose>-5 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy3"><pose>0 -5 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx4"><pose>-4 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy4"><pose>0 -4 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx5"><pose>-3 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy5"><pose>0 -3 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx6"><pose>-2 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy6"><pose>0 -2 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx7"><pose>-1 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy7"><pose>0 -1 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx8"><pose>0 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy8"><pose>0 0 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx9"><pose>1 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy9"><pose>0 1 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx10"><pose>2 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy10"><pose>0 2 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx11"><pose>3 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy11"><pose>0 3 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx12"><pose>4 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy12"><pose>0 4 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx13"><pose>5 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy13"><pose>0 5 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx14"><pose>6 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy14"><pose>0 6 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx15"><pose>7 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy15"><pose>0 7 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gx16"><pose>8 0 0.003 0 0 0</pose><geometry><box><size>0.03 16 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="gy16"><pose>0 8 0.003 0 0 0</pose><geometry><box><size>16 0.03 0.004</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
