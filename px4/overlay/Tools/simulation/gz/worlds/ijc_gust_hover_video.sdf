<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="ijc_gust_hover_video">
    <!-- generated by scripts/make_video_worlds.py -->
    <!-- ijc_control experiments: 1 kHz physics, standard gravity (= PX4 CONSTANTS_ONE_G),
         default PX4 systems plus IjcWrenchSystem (disturbance injection). -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- disturbance profile 'fronts_sharp' x 0.85 (IjcGustSystem), runs before the model systems -->
    <plugin filename="libIjcGustSystem.so" name="custom::IjcGustSystem">
      <gz:system_priority>-10</gz:system_priority>
      <scale>0.85</scale>
      <mean_speed>2.8</mean_speed>
      <mean_direction_deg>70.0</mean_direction_deg>
      <speed_sine amp="0.8" period="6.5" phase="0.0"/>
      <speed_sine amp="0.3" period="5.1" phase="1.3"/>
      <speed_sine amp="0.4" period="2.3" phase="0.4"/>
      <speed_sine amp="0.25" period="1.3" phase="2.1"/>
      <dir_sine amp_deg="12.0" period="9.0" phase="0.0"/>
      <dir_sine amp_deg="6.0" period="2.7" phase="0.9"/>
      <front t="10.000" rise="0.2" hold="4.0" fall="1.0" dspeed="2.8" ddir_deg="0.0"/>
      <front t="16.500" rise="0.2" hold="4.0" fall="1.0" dspeed="2.8" ddir_deg="0.0"/>
      <front t="23.000" rise="0.2" hold="4.0" fall="1.0" dspeed="2.8" ddir_deg="0.0"/>
      <front t="29.500" rise="0.2" hold="4.0" fall="1.0" dspeed="2.8" ddir_deg="0.0"/>
      <front t="36.000" rise="0.2" hold="4.0" fall="1.0" dspeed="2.8" ddir_deg="0.0"/>
      <front t="42.500" rise="0.2" hold="4.0" fall="1.0" dspeed="2.8" ddir_deg="0.0"/>
      <front t="13.000" rise="0.3" hold="2.5" fall="0.8" dspeed="0.0" ddir_deg="45.0"/>
      <front t="19.500" rise="0.3" hold="2.5" fall="0.8" dspeed="0.0" ddir_deg="-45.0"/>
      <front t="26.000" rise="0.3" hold="2.5" fall="0.8" dspeed="0.0" ddir_deg="45.0"/>
      <front t="32.500" rise="0.3" hold="2.5" fall="0.8" dspeed="0.0" ddir_deg="-45.0"/>
      <front t="39.000" rise="0.3" hold="2.5" fall="0.8" dspeed="0.0" ddir_deg="45.0"/>
      <front t="45.500" rise="0.3" hold="2.5" fall="0.8" dspeed="0.0" ddir_deg="-45.0"/>
      <turbulence_sigma>0.3</turbulence_sigma>
      <turbulence_sigma_z>0.12</turbulence_sigma_z>
      <turbulence_tau>0.3</turbulence_tau>
      <direction_noise_deg>3.0</direction_noise_deg>
      <rise_time>5.0</rise_time>
      <seed>7</seed>
      <trigger_topic>/ijc_gust_start</trigger_topic>
      <log_file>logs/video/wind_ijc_gust_hover_video.csv</log_file>
    </plugin>
    <plugin filename="libIjcVideoSystem.so" name="custom::IjcVideoSystem">
      <model_name>quadtailsitter_ijc_0</model_name>
      <link_name>base_link</link_name>
      <follow>false</follow>
      <camera_model>ijc_cam</camera_model>
      <look_at_offset>0.1 0 2.6</look_at_offset>
      <camera_offset>1.32 -1.574 0.437</camera_offset>
      <reference_model>ijc_ref</reference_model>
      <reference_height>2.5</reference_height>
      <trail_prefix>ijc_trail_</trail_prefix>
      <trail_count>50</trail_count>
      <trail_period>0.1</trail_period>
      <arrow_segment_prefix>ijc_arrow_seg_</arrow_segment_prefix>
      <arrow_segment_count>25</arrow_segment_count>
      <arrow_segment_length>0.1</arrow_segment_length>
      <arrow_head_model>ijc_arrow_head</arrow_head_model>
      <arrow_anchor>-0.7 0.9 1.0</arrow_anchor>
      <arrow_scale>0.17</arrow_scale>
    </plugin>
    <plugin filename="libIjcWrenchSystem.so" name="custom::IjcWrenchSystem">
      <link_name>base_link</link_name>
    </plugin>
    <!-- aerodynamic wrench on the vehicle (ground truth for the observers); runs after the model systems -->
    <plugin filename="libIjcAeroSystem.so" name="custom::IjcAeroSystem">
      <gz:system_priority>100</gz:system_priority>
      <model_name>quadtailsitter_ijc_0</model_name>
      <base_link>base_link</base_link>
      <moment_constant>0.06</moment_constant>
      <rotor direction="ccw">rotor_0</rotor>
      <rotor direction="ccw">rotor_1</rotor>
      <rotor direction="cw">rotor_2</rotor>
      <rotor direction="cw">rotor_3</rotor>
    </plugin>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <wind><linear_velocity>0 0 0</linear_velocity></wind>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.25 0.25 0.25 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <sky></sky>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.42 0.52 0.34 1</ambient>
            <diffuse>0.42 0.52 0.34 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <include>
      <name>ijc_ground_-1_-1</name>
      <uri>model://ijc_ground</uri>
      <pose>-32 -32 0.002 0 0 0</pose>
    </include>
    <include>
      <name>ijc_ground_-1_0</name>
      <uri>model://ijc_ground</uri>
      <pose>-32 0 0.002 0 0 0</pose>
    </include>
    <include>
      <name>ijc_ground_-1_1</name>
      <uri>model://ijc_ground</uri>
      <pose>-32 32 0.002 0 0 0</pose>
    </include>
    <include>
      <name>ijc_ground_0_-1</name>
      <uri>model://ijc_ground</uri>
      <pose>0 -32 0.002 0 0 0</pose>
    </include>
    <include>
      <name>ijc_ground_0_0</name>
      <uri>model://ijc_ground</uri>
      <pose>0 0 0.002 0 0 0</pose>
    </include>
    <include>
      <name>ijc_ground_0_1</name>
      <uri>model://ijc_ground</uri>
      <pose>0 32 0.002 0 0 0</pose>
    </include>
    <include>
      <name>ijc_ground_1_-1</name>
      <uri>model://ijc_ground</uri>
      <pose>32 -32 0.002 0 0 0</pose>
    </include>
    <include>
      <name>ijc_ground_1_0</name>
      <uri>model://ijc_ground</uri>
      <pose>32 0 0.002 0 0 0</pose>
    </include>
    <include>
      <name>ijc_ground_1_1</name>
      <uri>model://ijc_ground</uri>
      <pose>32 32 0.002 0 0 0</pose>
    </include>
    <model name="ijc_cam">
      <static>true</static>
      <pose>3 -2 3 0 0 0</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
          <topic>ijc_cam</topic>
          <camera>
            <horizontal_fov>0.8</horizontal_fov>
            <image><width>640</width><height>780</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>300</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
