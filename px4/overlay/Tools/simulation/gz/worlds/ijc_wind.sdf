<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="ijc_wind">
    <!-- ijc_control experiments, scenarios S2/S3: ijc_calm + Gazebo wind (WindEffects).
         Mean wind 4 m/s (ENU velocity (1.37, 3.76, 0): towards north-north-east, i.e. mostly along
         the body x axis of the vehicle, normal to the wing), gusts: magnitude +-25 % (3-5 m/s)
         with period 8 s and direction +-15 deg with period 13 s, plus gaussian turbulence.
         The wind velocity is used by the aerodynamic systems of the model (AdvancedLiftDrag of the
         wing, rotor drag of MulticopterMotorModel). -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>5</time_for_rise>
          <sin>
            <amplitude_percent>0.25</amplitude_percent>
            <period>8</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.3</stddev>
          </noise>
        </magnitude>
        <direction>
          <time_for_rise>5</time_for_rise>
          <sin>
            <amplitude>15</amplitude>
            <period>13</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>2</stddev>
          </noise>
        </direction>
      </horizontal>
      <vertical>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.2</stddev>
        </noise>
      </vertical>
    </plugin>
    <plugin filename="libIjcWrenchSystem.so" name="custom::IjcWrenchSystem">
      <link_name>base_link</link_name>
    </plugin>
    <!-- aerodynamic wrench on the vehicle (ground truth for the observers); runs after the model systems -->
    <plugin filename="libIjcAeroSystem.so" name="custom::IjcAeroSystem">
      <gz:system_priority>100</gz:system_priority>
      <model_name>quadtailsitter_ijc_0</model_name>
      <base_link>base_link</base_link>
      <moment_constant>0.06</moment_constant>
      <rotor direction="ccw">rotor_0</rotor>
      <rotor direction="ccw">rotor_1</rotor>
      <rotor direction="cw">rotor_2</rotor>
      <rotor direction="cw">rotor_3</rotor>
    </plugin>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <wind>
      <linear_velocity>1.368 3.759 0</linear_velocity>
    </wind>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
